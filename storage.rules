rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true; }
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if admin() && (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    match /branding/{fileName} {
      allow read: if true;
      allow write: if admin() && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
